# Copy to .dev.vars (gitignored) for `wrangler dev` / `npm run preview`.
# Real values go here — never commit .dev.vars. For deployed Workers, use
# `wrangler secret put <NAME>` or the Cloudflare dashboard secrets.
#
# Public vars are already in wrangler.toml [vars] with committed placeholders;
# you can override them here for local Cloudflare testing if needed.
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example
NEXT_PUBLIC_SUPABASE_ANON_KEY=example-anon-key-compat
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=example-vapid-public-key
VAPID_PUBLIC_KEY=example-vapid-public-key
APP_URL=https://duobalanceapp.com
FEEDBACK_RECIPIENT_EMAIL=hola@duobalanceapp.com
RESEND_FROM="DuoBalance <hola@duobalanceapp.com>"
RESEND_REPLY_TO=hola@duobalanceapp.com

# Billing (Phase A, #262) — exposure flag, OFF by default. Single accessor:
# src/lib/billing/enabled.ts. Keep empty until the go-live checklist
# (docs/billing-go-live-checklist.md) is signed off.
# BILLING_ENABLED=
# NEXT_PUBLIC_BILLING_ENABLED=

# Admin deployment canonical origin (Phase A, #271) — separate deployment
# with its own domain-scoped session (docs/admin-boundary.md). Public.
# ADMIN_APP_URL=http://localhost:3000
# Per-target admin serving (Phase A, #271): leave unset for local dev (both
# targets served; the billing flag still gates admin). Production/staging
# user Workers set APP_MODE=user; the admin Worker sets APP_MODE=admin.
# APP_MODE=

# Secrets — required for local `wrangler dev` to exercise handlers/crons
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
EXCHANGERATE_API_KEY=
RESEND_API_KEY=
CRON_SECRET=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@duobalanceapp.com

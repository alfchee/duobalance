{
  "crons": [
    {
      "path": "/api/cron/fx-refresh",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/generate-bill-instances",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/send-bill-reminders",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/purge-households",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/purge-accounts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/billing-expire",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/billing-dunning",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    },
    {
      "source": "/api/admin/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "private, no-store" }
      ]
    }
  ]
}

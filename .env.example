# Client (NEXT_PUBLIC_* — safe to ship in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase renamed anon → publishable. Either works; publishable is preferred for new projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used only in a Tauri webview; web deployments always use their own origin
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server only — never NEXT_PUBLIC_, never reachable from the browser
SUPABASE_SERVICE_ROLE_KEY=
# New Supabase secret format (sb_secret_…) — alias for the same service-role capability.
# Either SERVICE_ROLE_KEY (JWT) or SECRET_KEY (sb_secret_…) is accepted by the server.
SUPABASE_SECRET_KEY=
# Use the Session Pooler URL from Supabase Dashboard > Connect for IPv4-only networks.
SUPABASE_DB_URL=
EXCHANGERATE_API_KEY=
RESEND_API_KEY=
RESEND_FROM="DuoBalance <hola@duobalanceapp.com>"
RESEND_REPLY_TO="hola@duobalanceapp.com"
FEEDBACK_RECIPIENT_EMAIL="hola@duobalanceapp.com"
# Deployed web URL — used to build the /accept-invite/{token} link in invite emails
APP_URL="https://duobalanceapp.com"
CRON_SECRET=
# Set to true/1 on Vercel after cutover so its crons no-op (see #160, docs/cron-idempotency.md)
CRON_DISABLED=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Billing provider selection (Phase A, #258). Resolved by src/lib/billing/registry.ts.
# Defaults to "stub" when unset; real adapter ids land with their issues.
BILLING_PROVIDER=
# Billing exposure flag (Phase A, #262). Single accessor: src/lib/billing/enabled.ts.
# OFF by default — unset/empty means billing is not live and every checkout entry
# point, the webhook route, UI plan gating and admin billing screens stay hidden
# while entitlements evaluate as entitled. Do NOT turn on until the go-live
# checklist (docs/billing-go-live-checklist.md) is fully signed off.
BILLING_ENABLED=
# Client mirror of the flag for UI gating (useBillingEnabled/BillingGate).
# Same value as BILLING_ENABLED; needs a redeploy to take effect (NEXT_PUBLIC_*).
NEXT_PUBLIC_BILLING_ENABLED=

# Client (NEXT_PUBLIC_* — safe to ship in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Empty on web; set to absolute URL when serving from Tauri webview
NEXT_PUBLIC_API_BASE_URL=

# Server only — never NEXT_PUBLIC_, never reachable from the browser
SUPABASE_SERVICE_ROLE_KEY=
EXCHANGERATE_API_KEY=
RESEND_API_KEY=
CRON_SECRET=

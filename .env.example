# Client (NEXT_PUBLIC_* — safe to ship in the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase renamed anon → publishable. Either works; publishable is preferred for new projects.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Empty on web; set to absolute URL when serving from Tauri webview
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Server only — never NEXT_PUBLIC_, never reachable from the browser
SUPABASE_SERVICE_ROLE_KEY=
EXCHANGERATE_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
# Deployed web URL — used to build the /accept-invite/{token} link in invite emails
APP_URL=
CRON_SECRET=
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
